# Copy this file to .env (never commit .env) and fill it in. See docs/DEPLOY.md and docs/HOSTING.md.
# On a server, deploy/setup-server.sh does this for you and fills in the first few.

# Required: the database password. Make it long and random, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Online (with docker-compose.prod.yml): the domain, e.g. trivvoly.com. The site is https://<DOMAIN>.
DOMAIN=
# Let's Encrypt writes here if there's trouble with the HTTPS certificate
ACME_EMAIL=
# Shown on the privacy page for questions about people's data
CONTACT_EMAIL=

# Without docker-compose.prod.yml: the site's full address, e.g. https://trivvoly.example.com
PUBLIC_URL=

# Admins: the email addresses (comma-separated) whose accounts can open /admin
ADMIN_EMAILS=

# Optional: lets a monitoring service read /metrics with "Authorization: Bearer <this>"
METRICS_TOKEN=
# Optional: INFO (default) logs every request and game event; WARNING logs only problems
LOG_LEVEL=INFO

# Optional: "Continue with Google" (Google Cloud Console > Google Auth Platform > Clients)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: email sign-in links, through Resend...
MAIL_FROM=
RESEND_API_KEY=
# ...or through any SMTP server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
