# Copy this file to .env (never commit .env) and fill it in. See docs/HOSTING.md.

# Required: the database password. Make it long and random, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Online: the site's address, e.g. https://trivvoly.example.com
PUBLIC_URL=

# Optional: "Continue with Google" (Google Cloud Console > Google Auth Platform > Clients)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: email sign-in links, through Resend...
MAIL_FROM=
RESEND_API_KEY=
# ...or through any SMTP server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
